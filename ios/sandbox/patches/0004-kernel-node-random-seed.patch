diff --git a/kernel/exec.c b/kernel/exec.c
index 26fd317..42fc717 100644
--- a/kernel/exec.c
+++ b/kernel/exec.c
@@ -1006,7 +1006,8 @@ dword_t sys_execve(addr_t filename_addr, addr_t argv_addr, addr_t envp_addr) {
                     jitless = true;
             }
             // Conditionally inject --require for polyfill files that exist in guest fs.
-            // With real WebAssembly (the default mode) only the fetch transport is used.
+            // Always preload the guarded wasm shim: NODE_OPTIONS can disable
+            // WebAssembly too. The shim leaves native WebAssembly unchanged.
             static const char *optional_requires[] = {
                 "--require=/lib/wasm-polyfill.js",    // WebAssembly shim (must load first)
                 "--require=/lib/fetch-polyfill.js",   // undici dispatcher on native http/https
@@ -1020,7 +1021,31 @@ dword_t sys_execve(addr_t filename_addr, addr_t argv_addr, addr_t envp_addr) {
                 for (size_t i = 0; i < sizeof(inject_args_default)/sizeof(inject_args_default[0]); i++)
                     inject_args[inject_count++] = inject_args_default[i];
             }
-            for (size_t i = jitless ? 0 : 1; i < sizeof(optional_requires)/sizeof(optional_requires[0]); i++) {
+            // The jitless mode's --predictable fixes Math.random() to the
+            // same seed in every process. Keep npm cache filenames unique
+            // unless the caller explicitly requests a deterministic seed.
+            // The default mode already uses Node's normal entropy.
+            char random_seed_arg[48];
+            if (jitless) {
+                bool has_random_seed = false;
+                for (char *q = argv; *q != '\0'; q += strlen(q) + 1) {
+                    if (strncmp(q, "--random-seed=", 14) == 0 ||
+                        strcmp(q, "--random-seed") == 0)
+                        has_random_seed = true;
+                }
+                if (!has_random_seed) {
+                    dword_t seed;
+                    if (get_random((char *)&seed, sizeof(seed)) != 0) {
+                        err = _EIO;
+                        goto err_free_envp;
+                    }
+                    seed &= 0x7fffffff;
+                    if (seed == 0) seed = 1;
+                    snprintf(random_seed_arg, sizeof(random_seed_arg), "--random-seed=%u", seed);
+                    inject_args[inject_count++] = random_seed_arg;
+                }
+            }
+            for (size_t i = 0; i < sizeof(optional_requires)/sizeof(optional_requires[0]); i++) {
                 // Extract path after "--require="
                 const char *path = optional_requires[i] + 10; // strlen("--require=")
                 struct fd *fd = generic_open(path, O_RDONLY_, 0);
