 #define TIMER_ABSTIME_ (1 << 0)
 
@@ -192,6 +194,40 @@ uint_t sys_alarm(uint_t seconds) {
     return seconds;
 }
 
+/// Host `nanosleep` is not wired to iSH's `waiting_cond`, so `send_signal`
+/// (timeout / cancel) cannot wake a guest `sleep`. Wait on `current->pause`
+/// instead — the same interruptible path as pause(2) / sigsuspend.
+static int kelivo_sleep_interruptible(struct timespec *rel, struct timespec *rem) {
+    struct timespec start;
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    lock(&current->general_lock);
+    current->blocking = true;
+    int err = wait_for(&current->pause, &current->general_lock, rel);
+    current->blocking = false;
+    unlock(&current->general_lock);
+    if (rem != NULL) {
+        rem->tv_sec = 0;
+        rem->tv_nsec = 0;
+        if (err == _EINTR) {
+            struct timespec now;
+            clock_gettime(CLOCK_MONOTONIC, &now);
+            long sec = rel->tv_sec - (now.tv_sec - start.tv_sec);
+            long nsec = rel->tv_nsec - (now.tv_nsec - start.tv_nsec);
+            if (nsec < 0) {
+                sec--;
+                nsec += 1000000000L;
+            }
+            if (sec < 0) {
+                sec = 0;
+                nsec = 0;
+            }
+            rem->tv_sec = sec;
+            rem->tv_nsec = nsec;
+        }
+    }
+    return err == _EINTR ? _EINTR : 0;
+}
