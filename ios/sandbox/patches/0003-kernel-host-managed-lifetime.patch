diff --git a/kernel/task.h b/kernel/task.h
--- a/kernel/task.h
+++ b/kernel/task.h
@@ -238,6 +238,10 @@
     // iSH itself never interprets this value; host registers a meaning.
     uint64_t fs_context;

+    // Persistent host-managed services may legitimately wait indefinitely.
+    // Inherited on fork by tgroup_copy; cancellation still uses signals.
+    bool host_managed_lifetime;
+
     // for everything in this struct not locked by something else
     lock_t lock;
 };
diff --git a/fs/poll.c b/fs/poll.c
--- a/fs/poll.c
+++ b/fs/poll.c
@@ -549,7 +549,8 @@
             //   - pid 1 (init): legitimately idles, killing halts the system
             //   - processes with a controlling TTY: interactive shells idle
             //     waiting for user input and must not be killed
-            if (current->pid != 1 && current->group->tty == NULL) {
+            if (current->pid != 1 && current->group->tty == NULL &&
+                    !current->group->host_managed_lifetime) {
                 struct timespec _now;
                 clock_gettime(CLOCK_MONOTONIC, &_now);
                 uint64_t now_ns = (uint64_t)_now.tv_sec * 1000000000ULL + _now.tv_nsec;
