# Kelivo Workspace login defaults. Applied through the guest VFS at boot so
# installed rootfs images get the same configuration as new installations.
# The native launcher supplies defaults; preserve explicit user values.
export PATH="${PATH-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
export PAGER="${PAGER-less}"
umask 022

for script in /etc/profile.d/*.sh; do
    if [ -r "$script" ]; then
        . "$script"
    fi
done
unset script
